---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import team from "@data/employees.json";
import Footer from "@components/Footer.astro";
import DynamicImage from "@helpers/DynamicImage.astro";
import DynamicIcon from "@helpers/DynamicIcon.astro";

export function getStaticPaths() {
  return team.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
---

<Layout title={person.name}>
  <Header />
  <section class="info_img">
    <div class="img">
      <DynamicImage
        imagePath={person.img}
        altText={person.name}
        class="employee-image"
      />
    </div>
    <div class="info">
      <div class="ceo">
        <h1>{person.name}</h1>
        <h3>{person.title}</h3>
        <p>{person.description_long}</p>
      </div>
      <div class="past">
        <h1>Past Experience</h1>
        <p>{person.past_experience}</p>
      </div>
    </div>

    <div class="some">
      {
        person.social_links.map((link) => (
          <DynamicIcon
            name={link.icon}
            width={24}
            height={24}
            class="social-icon"
          />
        ))
      }
    </div>
  </section>
</Layout>

<Footer />

<style>
  .info_img {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 6rem;
  }

  .img {
    position: relative;
    width: 80%;
    justify-self: center;
    border-radius: 20px;
  }

  .img::before {
    content: "";
    position: absolute;
    width: 210px;
    height: 140px;
    background-color: var(--color-green-400);
    border-radius: var(--border-radius-l);
    transform: translate(-20%, -20%);
    z-index: -1;
  }

  .employee-image {
    grid-column: 1/2;
    position: relative;
    display: block;
    height: 20%;
    width: 90%;
    height: auto;
    z-index: 1;
    margin-bottom: 2rem;
    border-radius: 50px;
  }

  .info {
    grid-column: 2/3;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .info > div + div {
    border-top: 1px solid #c1c1c1;
    padding-top: 2rem;
  }

  .ceo,
  .past {
    > * + * {
      margin-top: var(--flow-space, 1rlh);
    }
  }

  .some {
    display: flex;
    gap: 20px;
    grid-column: 1/2;
    grid-row: 2;
    justify-self: center;
  }

  h1 {
    color: var(--color-neutrals-900);
  }

  h3 {
    color: var(--color-neutrals-700);
  }

  p {
    color: var(--color-neutrals-700);
  }

  /* Mobilvisning */
  @media (max-width: 800px) {
    .info_img {
      grid-template-columns: 1fr;
    }

    img,
    .info,
    .some {
      grid-column: 1 / -1;
    }
  }
</style>

<style is:global>
  @view-transition {
    navigation: auto;
  }
</style>
