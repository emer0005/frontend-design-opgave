---
import AccordionItem from "../components/AccordionItem.astro";
import faqData from "@data/faq.json";

const { data, exclusive } = Astro.props;
---

<section class="accordion-container">
  <h3>FAQ</h3>
  <h1>Customer Questions</h1>
  <div>
    {faqData.faq.map((faq) => <AccordionItem {...faq} exclusive={exclusive} />)}
  </div>
</section>

<style>
  section {
    padding-block: 3rem;
    background: #f5f5f5;
    max-width: 1200px;
    margin: 0 auto;
  }
  div {
    padding: 1rlh;
    max-width: 725px;
    margin-inline: auto;
  }
  h3 {
    color: (var(--color-neutrals-900));
  }
  h1 {
    font-size: var(--step-2);
    font-weight: 600;
    color: (var(--color-neutrals-900));
  }

  h1,
  h3 {
    text-align: center;
  }
</style>
