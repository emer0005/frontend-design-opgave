---

---

<button popovertarget="pop">Login</button>
<aside id="pop" popover="manual">
  <div>
    <h2>Dashboard Login</h2>
    <form>
      <input type="email" placeholder="Email" />
      <input type="password" placeholder="Password" />
      <button class="submit" type="submit">Go to dahboard</button>
    </form>
  </div>
</aside>

<style>
  button {
    background-color: var(--color-on-ui-primary);
    width: 100px;
    justify-self: end;
    border-radius: var(--border-radius-xl);
  }

  [popovertarget] {
    anchor-name: --button;
  }

  [popover] {
    --arrow-size: 0.6rem;
    position-area: bottom;
    margin: 0.6rem;
    border: none;
    border-radius: 10px;
    padding: 1rem;

    &::before {
      content: "";
      position: fixed;
      width: calc(var(--arrow-size) * 1.667);
      height: var(--arrow-size);
      background: inherit;
      clip-path: polygon(0 100%, 50% 0, 100% 100%);
      position-anchor: --button;
      position-area: bottom;
    }
    &::backdrop {
      background: #0003;
    }
  }

  h2 {
    margin-bottom: 10px;
  }

  input {
    border-radius: 20px;
    border: 1px solid grey;
  }

  .submit {
    background-color: var(--color-surface-highlight);
    width: 100%;
    border: none;
    padding-inline: 1rem;
    padding: 10px;
    border-radius: 20px;
    justify-self: stretch;
  }

  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
</style>
