---
import experienceData from "@data/experience.json";
---

<section>
  <div class="grid">
    <div class="tekst">
      <h3>{experienceData.eyebrow}</h3>
      <h1>{experienceData.title}</h1>
      <h2>{experienceData.subtitle}</h2>
    </div>

    <article>
      <div>
        <div class="stats" style="--value:85;"></div>
        <p>{experienceData.stats[0].label}</p>
      </div>
      <div>
        <div class="stats" style="--value:95;"></div>
        <p>{experienceData.stats[1].label}</p>
      </div>
      <div>
        <div class="stats" style="--value:90;"></div>
        <p>{experienceData.stats[2].label}</p>
      </div>
    </article>
  </div>
</section>

<style>
  @property --animatedNumber {
    syntax: "<number>";
    initial-value: 0;
    inherits: true;
  }

  @keyframes countUp {
    from {
      --animatedNumber: 0;
    }
    to {
      --animatedNumber: var(--value);
    }
  }

  .stats {
    /* VIEW-TIMELINE: kør når .stats kommer i viewport */
    view-timeline-name: --stats;
    view-timeline-axis: block;

    animation-name: countUp;
    animation-duration: 1s;
    animation-timing-function: ease-out;
    animation-fill-mode: both;
    animation-timeline: --stats;
    animation-range: entry 0% cover 40%;

    /* DATA TIL ANIMATIONEN */
    --animatedNumber: 0;
    --percentage: calc(var(--animatedNumber) * 1%);
    --bd: 6px;

    /* LAYOUT & STYLING */
    width: 180px;
    aspect-ratio: 1;
    position: relative;
    border-radius: 999px;
    border: var(--bd) solid #0000;
    display: grid;
    container: stat / inline-size;

    background:
      radial-gradient(
          circle at 50% calc(var(--bd) / 2),
          white calc(var(--bd) / 2),
          #0000 0
        )
        border-box,
      linear-gradient(var(--color-yellow-600)) padding-box,
      conic-gradient(white var(--percentage), #daae3c 0) border-box;
  }

  .stats::after {
    counter-reset: val round(var(--animatedNumber));
    grid-area: 1 / 1;
    content: counter(val) "%";
    place-self: center;
    font-size: 30cqw;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    font-weight: 800;
  }

  .stats::before {
    content: "";
    position: absolute;
    width: calc(var(--bd) * 3);
    aspect-ratio: 1;
    border-radius: calc(infinity * 1px);
    background: black;
    border: 4px solid white;
    offset: border-box var(--percentage);
    offset-anchor: 50% calc(50% - var(--bd) / 2);
  }

  article {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 2rem;
    width: 100%;
    background-color: var(--color-surface-highlight);
  }

  section {
    background-color: var(--color-surface-highlight);
    padding: var(--paddingtb);
  }

  .grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
  }

  .tekst {
    > * + * {
      margin-block-start: var(--flow-space, 1rlh);
    }
  }

  p {
    color: var(--color-text);
    font-weight: 500;
    max-width: 600px;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .stats {
      animation: none !important;
      --animatedNumber: var(--value);
    }
  }

  @media (max-width: 600px) {
    .grid {
      flex-direction: column;
      gap: 2rem;
    }

    article {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
