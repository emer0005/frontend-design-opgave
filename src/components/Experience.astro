---
import experienceData from "@data/experience.json";
---

<section>
  <div class="grid">
    <div>
      <h3>{experienceData.eyebrow}</h3>
      <h1>{experienceData.title}</h1>
      <h2>{experienceData.subtitle}</h2>
    </div>

    <article>
      <div>
        <div class="stats" style="--value:85;"></div>
        <p>{experienceData.stats[0].label}</p>
      </div>
      <div>
        <div class="stats" style="--value:95;"></div>
        <p>{experienceData.stats[1].label}</p>
      </div>
      <div>
        <div class="stats" style="--value:90;"></div>
        <p>{experienceData.stats[2].label}</p>
      </div>
    </article>
  </div>
</section>

<style>
  @property --animatedNumber {
    syntax: "<number>";
    initial-value: 0;
    inherits: true;
  }
  .stats {
    width: 150px;
    aspect-ratio: 1;
    flex: 0 1 150px;
    min-width: 0;
    --animatedNumber: var(--value);
    --percentage: calc(var(--animatedNumber) * 1%);
    --bd: 6px;
    position: relative;
    border: var(--bd) solid #0000;
    content: "";
    background:
      radial-gradient(
          circle at 50% calc(var(--bd) / 2),
          white calc(var(--bd) / 2),
          #0000 0
        )
        border-box,
      linear-gradient(var(--color-yellow-600)) padding-box,
      conic-gradient(white var(--percentage), #daae3c 0) border-box;
    border-radius: 999px;

    display: grid;
    container: stat / inline-size;
    transition: --animatedNumber 2s;
    &::after {
      counter-reset: val round(var(--animatedNumber));
      grid-area: 1 / 1;
      content: counter(val) "%";
      place-self: center;
      font-size: 30cqw;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
      font-weight: 800;
    }
    &::before {
      content: "";
      position: absolute;
      width: calc(var(--bd) * 3);
      aspect-ratio: 1;
      border-radius: calc(infinity * 1px);
      background: black;
      border: 4px solid white;
      offset: border-box var(--percentage);
      offset-anchor: 50% calc(50% - var(--bd) / 2);
    }
  }

  article {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    background-color: var(--color-surface-highlight);
  }

  section {
    background-color: var(--color-surface-highlight);
    margin-top: 2rem;
    padding-bottom: 5rem;
    padding-top: 5rem;
  }

  .grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
  }

  h3 {
    color: var(--color-neutrals-900);
  }
  h1 {
    font-size: var(--step-2);
    font-weight: 600;
    color: (var(--color-neutrals-900));
  }
  p {
    color: var(--color-neutrals-700);
    max-width: 600px;
    text-align: center;
  }

  @media (max-width: 600px) {
    .grid {
      flex-direction: column;
      gap: 2rem;
    }

    article {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
