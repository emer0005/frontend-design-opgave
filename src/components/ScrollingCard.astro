---
const { finan } = Astro.props;
import DynamicIcon from "@helpers/DynamicIcon.astro";
---

<article class="card">
  <DynamicIcon name={finan.icon} width={24} height={24} class="social-icon" />
  <h1>{finan.title}</h1>
  <p>{finan.description}</p>
</article>

<style>
  @layer components {
    article {
      background: var(--color-surface-tertiary);
      color: var(--color-on-surface-elevated);
      padding: 2rem;
      border-radius: 20px;

      .social-icon {
        color: var(--color-text);
      }
    }

    .card {
      flex: 0 0 400px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      gap: 2rem;

      > * + * {
        margin-top: var(--flow-space, 1rlh);
      }
    }

    h1 {
      font-size: var(--step-1);
    }
  }
</style>
