---
const { finan } = Astro.props;

import cal from "@icons/cal.svg?url";
import card from "@icons/card.svg?url";
import law from "@icons/law.svg?url";
import money from "@icons/money.svg?url";

const icons = {
  cal,
  card,
  law,
  money,
};
---

<article class="card">
  <img src={icons[finan.icon]} alt={finan.icon} />
  <h1>{finan.title}</h1>
  <p>{finan.description}</p>
</article>

<style>
  @layer components {
    article {
      background: var(--color-surface-tertiary);
      color: var(--color-on-surface-elevated);
      padding: 2rem;
      border-radius: 20px;
    }

    .card {
      flex: 0 0 400px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      gap: 2rem;
    }

    h1 {
      color: var(--color-neutrals-900);
      font-size: var(--step-1);
      font-weight: 500;
      margin-bottom: 1rem;
    }

    p {
      color: var(--color-neutrals-700);
    }
  }
</style>
