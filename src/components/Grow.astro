---
import valuesData from "@data/coreValues.json";
import GrowCard from "./GrowCard.astro";
import ArrowRight from "@icons/arrow--right.svg";
const { variant } = Astro.props;
---

<section class={`${variant}`}>
  <div class="grid">
    <div class="grid_1-1">
      <div>
        <h5>{valuesData.eyebrow}</h5>
        <h1>{valuesData.title}</h1>
        <p>{valuesData.subtitle}</p>
      </div>

      <button>Get in touch</button>
    </div>

    <div class="values">
      {
        valuesData.values.map((value) => (
          <GrowCard value={value} variant="about" />
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background-color: var(--color-text);

    padding: 8lh 1lh;
    --grid-color: oklch(from var(--color-surface-highlight) l c h / 0.18);
    --grid-size: 60px;

    background:
      radial-gradient(ellipse farthest-side at 60% 60%, #0000 10%, #030712 75%),
      conic-gradient(
          from 180deg at 1px 1px,
          var(--grid-color) 75%,
          #0000 0
        ) -1px -1px /
        var(--grid-size) var(--grid-size),
      #030712;
    /*background-color: #000;
  background-positon: -1px -1px;
  background-repeat: repeat;
  background-image: conic-gradient(from 180deg at 1px 1px, red 75%, #0000 0);
  background-size: 60px 60px;*/
    color: #fff;

    padding: var(--paddingtb);

    & > * + * {
      margin-top: var(--space-xs, 1rlh);
    }
  }

  .grid {
    max-width: 1200px;
    margin: 0 auto;
    > * + * {
      margin-block-start: var(--flow-space, 1rlh);
    }
  }
  .grid_1-1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  button {
    color: var(--color-ui-primary);
    background: oklch(from var(--color-on-ui-primary) calc(l var(--l,)) c h);
    place-self: end; /* eller center, end */
    padding: 10px 2rem;
    border-radius: 20px;

    &:hover {
      /* øg lightness med 5% */
      --l: -/* */ 0.05;
    }
    &:active {
      /* øg lightness med 10% */
      --l: -/* */ 0.1;
    }
  }

  .about button {
    background: oklch(from var(--color-ui-primary) calc(l var(--l,)) c h);

    color: var(--color-on-ui-primary);

    &:hover {
      /* øg lightness med 5% */
      --l: +/* */ 0.2;
    }
    &:active {
      /* øg lightness med 10% */
      --l: +/* */ 0.1;
    }
  }
  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
  h5 {
    color: var(--color-on-ui-primary);
  }
  h1 {
    color: var(--color-on-ui-primary);
  }
  p {
    color: var(--color-on-ui-primary);
    max-width: 600px;
  }

  .about h1 {
    color: var(--color-text);
  }

  .about h5 {
    color: var(--color-text-muted);
  }

  .about p {
    color: var(--color-text-muted);
  }

  .about {
    background: var(--color-surface-secondary);
  }
</style>
