---
const { value, variant } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article class={`card ${variant}`}>
  <h1>{value.title}</h1>
  <p>{value.description}</p>
  <a href="#">Read more <ArrowRight stroke-width={2.5} /></a>
</article>

<style>
  @layer components {
    article {
      background: var(--color-surface-tertiary);
      color: var(--color-on-surface-elevated);
      padding: 2rem; /* Dette burde være en token */
      border-radius: 20px; /* Dette burde være en token */
      width: 275px;
      > * + * {
        margin-block-start: var(--flow-space, 1rlh);
      }
    }

    .about {
      background: var(--color-surface-primary);
    }

    h1 {
      color: var(--color-neutrals-900);
      font-size: var(--step-1);
      font-weight: 500;
      margin-bottom: 1rem;
    }

    p {
      color: var(--color-neutrals-700);
    }

    a {
      display: inline flex;
      gap: 1ch;
      color: var(--color-text);
      font-weight: bold;
      text-decoration: none;
      margin-top: 1rem;

      svg {
        inline-size: 16px;
      }
    }
  }

  @media (max-width: 768px) {
    .cards,
    .grid,
    .container {
      display: flex;
      flex-direction: column;
      align-items: center; /* ← centrerer kortene */
      gap: 2rem;
    }

    article.card {
      margin: 0 auto; /* ekstra sikkerhed */
    }
  }
</style>
