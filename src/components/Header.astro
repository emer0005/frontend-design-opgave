---
import LogIn from "./LogIn.astro";
---

<nav>
  <div class="nav">
    <a class="logo" href="index.html">Ask<span>Experts</span></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="burger">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="menu">
      <li><a href="index.html">Home</a></li>
      <li><a href="/casestudy.html">Case study</a></li>
      <li><a href="/team.html">Team</a></li>
      <li><a href="/about">About</a></li>

      <!-- LOGIN TIL MOBIL -->
      <li popovertarget="pop" class="login-mobile"><LogIn /></li>
    </ul>
    <li popovertarget="pop" class="login-desk"><LogIn /></li>
  </div>
</nav>

<style>
  nav {
    background-color: var(--color-surface-elevated);
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    max-width: 75rem;
    margin-inline: auto;
    align-items: center;
  }

  .menu {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 0;
  }

  .login-desk {
    display: flex;
    justify-content: flex-end;
  }
  .logo {
    color: var(--color-surface-tertiary);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .logo span {
    color: var(--color-surface-highlight);
  }

  li {
    list-style: none;
  }

  li a {
    color: var(--color-on-ui-primary);
    text-decoration: none;
    font-size: var(--step--1);
  }

  button {
    background-color: var(--color-on-ui-primary);
    width: 100px;
    justify-self: end;
    border-radius: var(--border-radius-xl);
  }
  .burger,
  .nav-toggle {
    display: none;
  }

  .login-mobile {
    display: none;
  }

  @media (max-width: 800px) {
    /******** Generelt styling mobil *********/

    .logo {
      font-size: var(--step-2);
    }

    .nav {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: 1rem;
      margin-left: 1rem;
      margin-right: 1rem;
    }

    .login-desk {
      display: none;
    }

    .login-mobile {
      display: none;
      margin-top: 1rem;
    }

    .menu {
      display: none;
      flex-direction: column;
      gap: 1rem;
      width: 100%;

      & a {
        color: var(--color-on-ui-primary);
        text-decoration: none;
        font-size: var(--step-1);
      }
    }

    /******** Burgermenu *********/

    .burger {
      display: flex;
      justify-self: end;
      width: 28px;
      height: 24px;
      position: relative;
      cursor: pointer;
      z-index: 20;
    }

    .burger span {
      position: absolute;
      left: 0;
      width: 28px;
      height: 3px;
      background: var(--color-on-ui-primary);
      border-radius: 3px;
      transition: 0.25s ease;
    }

    .burger span:nth-child(1) {
      top: 2px;
    }
    .burger span:nth-child(2) {
      top: 10px;
    }
    .burger span:nth-child(3) {
      top: 18px;
    }

    .nav-toggle {
      display: block;
      position: absolute;
      opacity: 0;
      width: 30px;
      height: 30px;
      right: 1rem;
      top: 1.5rem;
      cursor: pointer;
      z-index: 30;
    }

    .nav-toggle:checked ~ .menu {
      display: flex;
      background: var(--color-surface-elevated);
      padding: 1.5rem;
      border-radius: 0 0 20px 20px;
      margin-top: 1rem;
    }

    .nav-toggle:checked ~ .menu .login-mobile {
      display: block;
    }

    .nav-toggle:checked + .burger span:nth-child(1) {
      top: 10px;
      transform: rotate(45deg);
    }

    .nav-toggle:checked + .burger span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked + .burger span:nth-child(3) {
      top: 10px;
      transform: rotate(-45deg);
    }
  }
</style>
