---
const { employee, variant } = Astro.props;
import Instagram from "@icons/instagram.svg";
import Facebook from "@icons/facebook.svg";
---

<article class={`${variant}`}>
  <div class="card">
    {
      variant === "about" ? (
        <>
          <img src={employee.img} alt={employee.name} />

          <div class="text">
            <h3>{employee.title}</h3>
            <h1>
              <a href={`/${employee.slug}`} />
              {employee.name}
            </h1>
            <p>{employee.description}</p>
          </div>
        </>
      ) : (
        <div class="image-wrapper">
          <img src={employee.img} alt={employee.name} />
          <h3>{employee.title}</h3>
          <h1>
            <a href={`/${employee.slug}`} />
            {employee.name}
          </h1>
          <p>{employee.description}</p>
        </div>
      )
    }
    <div class="icons">
      <Instagram />
      <Facebook />
    </div>
    <a href={`/${employee.slug}`} class="employee-link"></a>
  </div>
</article>

<style>
  /************* Generelt styling ***********/

  h1,
  h3,
  p {
    margin: 0;
  }

  p {
    color: var(--color-text-muted);
  }

  h1 {
    color: var(--color-text);
  }

  img {
    border-radius: 10px;
    object-fit: cover;
    align-self: stretch;
  }

  .about,
  .meetteam {
    position: relative;
  }

  h1 a {
    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }
  }

  /*************** About ********************/

  .about {
    container-type: inline-size;
    display: grid;
    width: 100%;

    h3 {
      color: var(--color-text);
      font-weight: 700;
    }

    .icons {
      display: none;
    }
  }

  .about .card {
    display: grid;
  }

  @container (width > 450px) {
    .about .card {
      grid-template-columns: 1fr 3fr;
      gap: 2rem;

      .text {
        align-self: center;
      }
    }
  }

  /************** team site *****************/

  .meetteam {
    max-width: 400px;
    display: flex;
    flex-direction: column;

    .image-wrapper {
      display: grid;
      gap: var(--space-xs);
    }

    .image-wrapper img,
    .image-wrapper h3 {
      grid-area: 1 / 1;
    }

    h3 {
      align-self: end;
      justify-self: end;
      margin: 0.75rem;
      padding: 0.3rem 0.6rem;
      background: black;
      color: white;
      border-radius: 20px;
      font-size: var(--step--1);
      font-weight: 600;
    }

    h1 {
      text-align: center;
      font-weight: 700;
    }

    p {
      text-align: center;
    }

    .icons {
      display: flex;
      gap: 20px;
      justify-content: center;
      margin-top: auto;
    }

    .card {
      display: flex;
      flex-direction: column;
      height: 100%;
      gap: var(--space-xs);
    }
  }
</style>
