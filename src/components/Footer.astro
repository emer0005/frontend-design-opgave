<style>
  footer {
    background-color: var(--color-surface-elevated);
    margin-top: 5rem;
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);
  }

  .footer {
    display: flex;
    justify-content: space-between;
    max-width: 75rem;
    margin: 0 auto;
  }

  @media (width < 600px) {
    .footer {
      display: grid;
      grid-template-columns: 1fr;
      text-align: center;
      gap: 10px;
    }
  }

  .text {
    max-width: 75rem;
    margin: 0 auto;
    padding-bottom: var(--space-l);
    text-align: center;
    > * + * {
      margin-block-start: var(--flow-space, 1rlh);
    }
  }

  input {
    border-radius: 40px;
    border: 2px solid var(--color-text-weak);
    padding: 10px;
  }

  button {
    background: oklch(from var(--color-action) calc(l var(--l,)) c h);
    padding: 10px;
    border-radius: 40px;
    border: none;

    &:hover {
      /* øg lightness med 5% */
      --l: +/* */ 0.05;
    }
    &:active {
      /* øg lightness med 10% */
      --l: +/* */ 0.1;
    }
  }

  .logo {
    color: var(--color-surface-tertiary);
    font-size: var(--step-1);
    font-weight: 600;
    text-box: trim-both cap alphabetic;

    @supports not (text-box-trim: trim-both) {
      margin-top: calc(0.5cap- 0.5lh);
    }
  }

  .logo span {
    color: var(--color-surface-highlight);
  }

  h1 {
    color: var(--color-on-ui-primary);
    font-weight: 500;
    font-size: var(--step-1);
  }

  span,
  h3 {
    color: var(--color-action);
  }

  p {
    color: var(--color-text-weak);
  }
</style>
