---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import ArrowRight from "@icons/arrow--right.svg";
---

<section class="hero">
  <div class="background"></div>
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a href="#0">Book a Meeting</a>
    <a href="#0">Learn More <ArrowRight stroke-width={2.5} /></a>
  </div>
  <Image src={CEOImage} alt="CEO" />
  <div class="services">
    <Services />
  </div>
</section>

<style>
  @layer components {
    .hero {
      background-color: var(--color-ui-primary);
      container-type: inline-size;

      display: grid;
      gap: var(--space-m);

      & img {
        display: none;
      }
    }

    .hero-content {
      padding: 2rem;

      & > * + * {
        margin-top: var(--space-s, 1rlh);
      }
    }

    /****************** @media ****************/
    @media (min-width: 800px) {
      .hero {
        background: none;
        grid-template-columns: 1fr minmax(0, 600px) minmax(0, 600px) 1fr;
        grid-template-rows: auto 1fr 1fr;
        align-items: center;
        width: 100%;
      }

      .background {
        background-color: var(--color-ui-primary);
        grid-column: 1 / -1;
        grid-row: 1 / 3;
        height: 100%;

        /*************** Gitterbaggrund *******************/
        padding: 8lh 1lh;
        --grid-color: oklch(from #ffcc4a l c h / 0.18);
        --grid-size: 60px;

        background:
          radial-gradient(
            ellipse farthest-side at 60% 60%,
            #0000 10%,
            #030712 75%
          ),
          conic-gradient(
              from 180deg at 1px 1px,
              var(--grid-color) 75%,
              #0000 0
            ) -1px -1px /
            var(--grid-size) var(--grid-size),
          #030712;
        color: #fff;
      }

      /**********************************/

      .hero-content {
        grid-column: 2/3;
        grid-row: 1/2;
      }

      img {
        grid-column: 3/5;
        grid-row: 1/3;
        object-fit: cover;
        align-self: stretch;
        overflow: hidden;
        width: 100%;
        height: auto;
      }

      .services {
        grid-column: 2/4;
        grid-row: 2/4;
      }

      .hero img {
        display: block;
      }
    }

    /**************************************/

    /**************** Styling af tekst *****************/

    .hero-content {
      & h1 {
        color: var(--color-on-ui-primary);
        font-size: var(--step-4);
        font-weight: bold;
        width: 15ch;
      }

      & p {
        color: var(--color-on-ui-primary-muted);
        font-size: var(--step-1);
      }
      a {
        border-radius: var(--border-radius-xl);
        padding-block: 12px;
        padding-inline: 18px;
        background-color: var(--color-ui-primary);
        color: var(--color-on-ui-primary);
        text-decoration: none;
        outline: 1px solid var(--color-on-ui-primary-muted);
        display: inline-flex;
        gap: 1ch;
        font-size: var(--step-1);
        font-weight: 500;

        svg {
          inline-size: 16px;
          color: var(--color-on-ui-primary);
        }

        &:not(:last-child) {
          background-color: var(--color-action);
          color: var(--color-text);
          outline: none;
        }
      }
    }
  }
</style>
