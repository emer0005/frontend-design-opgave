---
import EmployeeData from "@data/employees.json";
import Employees from "@components/Employees.astro";
---

<section>
  <div>
    <h2>OUR TEAM</h2>
    <h1>We champion the bold</h1>
    <p>
      Our success stems from the synergy between dedicated teams and our valued
      clients. We prioritize a company culture that fosters exceptional
      productivity, ensures customer satisfaction.
    </p>
    <button>Meet the team</button>
  </div>

  <div class="values">
    {
      EmployeeData.filter(
        (employee) => employee.id === 1 || employee.id === 2,
      ).map((employee) => <Employees employee={employee} variant="about" />)
    }
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1200px;
    margin: 0 auto;
  }

  .values {
    container: card / inline-size;
  }

  @container card (width > 300px) {
    grid-template-columns: 1fr 3fr;
  }

  h3 {
    color: (var(--color-neutrals-900));
  }
  h1 {
    font-size: var(--step-2);
    font-weight: 600;
    color: (var(--color-neutrals-900));
  }

  p {
    color: var(--color-neutrals-700);
  }

  button {
    background-color: var(--color-neutrals-900);
    color: var(--color-on-ui-primary);
    padding: 10px;
    border-radius: 30px;
  }
</style>
