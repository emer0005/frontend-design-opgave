---
import EmployeeData from "@data/employees.json";
import Employees from "@components/Employees.astro";
---

<section>
  <div class="team_hero">
    <div class="tekst">
      <h1>Meet Our Great Team</h1>
      <p>
        Welcome to our amazing team! We are a group of passionate individuals
        dedicated to excellence and innovation. Each member brings unique skills
        and experiences, working together to achieve our goals. Join us as we
        embark on exciting projects and create lasting impacts.
      </p>
    </div>
    <button>Join our team</button>
  </div>

  <div class="team">
    {
      EmployeeData.map((employee) => (
        <Employees employee={employee} variant="meetteam" />
      ))
    }
  </div>
</section>

<style>
  .team {
    display: grid;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    justify-content: center;
    justify-items: center;
    align-items: stretch;
  }

  @view-transition {
    navigation: auto;
  }

  /******************* Tekst sektion ****************/

  .team_hero {
    --2-col: 1fr 1fr;
    display: grid;
    grid-template-columns: var(--2-col);
    max-width: 1200px;
    margin-inline: auto;

    button {
      background: oklch(from var(--color-ui-primary) calc(l var(--l,)) c h);
      color: var(--color-on-ui-primary);
      place-self: end; /* eller center, end */
      padding: 10px 2rem;
      border-radius: 20px;

      &:hover {
        /* øg lightness med 5% */
        --l: +/* */ 0.3;
      }
      &:active {
        /* øg lightness med 10% */
        --l: +/* */ 0.1;
      }
    }

    h1 {
      color: var(--color-text);
    }

    p {
      color: var(--color-text-muted);
    }
  }

  .tekst {
    padding: var(--paddingtb);

    > * + * {
      margin-top: var(--flow-space, 1rlh);
    }
  }
</style>
