---
import EmployeeData from "@data/employees.json";
import Employees from "@components/Employees.astro";
---

<section class="team">
  {
    EmployeeData.map((employee) => (
      <Employees employee={employee} variant="meetteam" />
    ))
  }
</section>

<style>
  .team {
    display: grid;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    justify-content: center;
    justify-items: center;
    align-items: stretch;
  }

  @view-transition {
    navigation: auto;
  }
</style>
