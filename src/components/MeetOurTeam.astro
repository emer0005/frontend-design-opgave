---
import EmployeeData from "@data/employees.json";
import Employees from "@components/Employees.astro";
---

<section>
  <div class="team_hero">
    <h1>Meet Our Great Team</h1>
    <p>
      Welcome to our amazing team! We are a group of passionate individuals
      dedicated to excellence and innovation. Each member brings unique skills
      and experiences, working together to achieve our goals. Join us as we
      embark on exciting projects and create lasting impacts.
    </p>
    <button>Join our team</button>
  </div>

  <div class="team">
    {
      EmployeeData.map((employee) => (
        <Employees employee={employee} variant="meetteam" />
      ))
    }
  </div>
</section>

<style>
  section {
    padding: var(--paddingtb);
  }
  .team {
    display: grid;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    justify-content: center;
    justify-items: center;
    align-items: stretch;
  }

  @view-transition {
    navigation: auto;
  }

  /******************* Tekst sektion ****************/

  .team_hero {
    max-width: 1200px;
    margin-inline: auto;
  }

  .team_hero {
    > * + * {
      margin-top: var(----flow-space, 1rlh);
    }

    button {
      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
      place-self: end; /* eller center, end */
      padding: 10px 2rem;
      border-radius: 20px;
    }

    @media (width > 800px) {
      .team_hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
