---
import { Image } from "astro:assets";
import wteImage from "@assets/images/what_to_expect.webp";
import Checkmark from "@icons/checkmark.svg";
---

<section>
  <div class="wte_card">
    <Image src={wteImage} alt="CEO" />
  </div>
  <div class="wte_content">
    <h2>WE'LL WORK WITH YOU</h2>
    <h1>What To Expect</h1>
    <p>
      Our collaboration is built on transparency, efficiency, and measurable
      results. Together, we create strategies tailored to your unique needs and
      goals.
    </p>
    <ul>
      <li>
        Collaborate to build actionable strategies that drive sustainable growth
        and deliver tangible outcomes.
      </li>
      <li>
        Identify opportunities to optimize processes and implement impactful
        solutions with measurable results.
      </li>
    </ul>
  </div>
</section>

<style>
  section {
    margin-top: 5rem;
    margin-bottom: 2rem;
  }
  :root {
    --checkmark-icon: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path fill="%234EAF4E" d="M176.49 95.51a12 12 0 0 1 0 17l-56 56a12 12 0 0 1-17 0l-24-24a12 12 0 1 1 17-17L112 143l47.51-47.52a12 12 0 0 1 16.98.03M236 128A108 108 0 1 1 128 20a108.12 108.12 0 0 1 108 108m-24 0a84 84 0 1 0-84 84a84.09 84.09 0 0 0 84-84"/></svg>');
  }

  ul {
    display: grid;
    gap: 1rem;
    max-width: 45ch;
    padding-left: 0;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    text-box: trim-start cap alphabetic;
  }

  li:before {
    content: "";
    width: 1.6rem;
    height: 1lh;
    background: var(--checkmark-icon) 50% 50% / 100% auto no-repeat;
  }

  .wte_card {
    position: relative;
    width: 80%;
    margin-left: 4rem;
  }

  .wte_card::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 160px;
    background-color: var(--color-green-400);
    border-radius: var(--border-radius-l);
    transform: translate(-20%, -20%);
    z-index: 0;
  }

  .wte_card img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    z-index: 1;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: var(--step--1);
    color: (var(--color-neutrals-900));
  }

  h1 {
    font-size: var(--step-2);
    font-weight: 600;
    color: (var(--color-neutrals-900));
  }

  p,
  li {
    color: var(--color-text-muted);
  }

  .wte_content {
    margin: 0 auto;
    padding: 0rem 2rem;

    & > * + * {
      margin-top: var(--space-s, 1rlh);
      text-wrap: balance;
      text-wrap: pretty;
    }
  }

  @media (min-width: 800px) {
    section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: 1200px;
      margin: 0 auto;
      margin-top: 5rem;
    }

    .wte_card {
      order: -1;
    }
  }
</style>
