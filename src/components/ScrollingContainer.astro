---
import finanData from "@data/financialProjections.json";
import ScrollingCard from "@components/ScrollingCard.astro";
import Navigation1 from "@icons/navigation1.svg";
---

<section>
  <div class="grid">
    <div class="tekst">
      <h5>{finanData.eyebrow}</h5>
      <h1>{finanData.title}</h1>
      <p>{finanData.subtitle}</p>
    </div>
    <div class="svg">
      <Navigation1 />
    </div>
  </div>
  <div class="cards_container">
    <div class="cards">
      {finanData.values.map((finan) => <ScrollingCard finan={finan} />)}
    </div>
  </div>
</section>

<style>
  @layer components {
    .tekst {
      > * + * {
        margin-block-start: var(--flow-space, 1rlh);
      }
    }

    .svg {
      margin-top: 2rem;
    }
    /************* Cards *************/
    .cards_container {
      max-width: 1200px;
      margin-inline: auto;
      overflow: visible;

      .cards {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        scroll-snap-type: inline mandatory;
        width: 100vw;
      }
    }

    /*************** @media *************/

    @media (width > 600px) {
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 1200px;
        margin-inline: auto;
      }

      .svg {
        justify-self: end;
        align-self: end;
      }
    }

    /************************************/

    section {
      overflow: hidden;
      background-color: var(--color-neutrals-100);
      padding: var(--paddingtb);

      > * + * {
        margin-top: var(--flow-space, 1rlh);
      }
    }

    .svg {
      width: 100px;
    }
  }
</style>
