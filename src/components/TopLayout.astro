---
const { eyebrow, title, text } = Astro.props;
---

<div class="back">
  <section>
    <h3>{eyebrow}</h3>
    <h1>{title}</h1>
    <p>{text}</p>
  </section>
</div>

<style>
  .back {
    background-color: var(--color-surface-secondary);
  }

  section {
    text-align: center;
    max-width: 65ch;
    margin: 0 auto;
  }
  h1 {
    color: var(--color-neutrals-900);
    font-size: var(--step-1);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  p {
    color: var(--color-neutrals-700);
  }
</style>
