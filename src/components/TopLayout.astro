---
const { eyebrow, title, text } = Astro.props;
---

<div class="back">
  <section>
    <h3>{eyebrow}</h3>
    <h1>{title}</h1>
    <p>{text}</p>
  </section>
</div>

<style>
  .back {
    background-color: var(--color-surface-secondary);
  }

  section {
    text-align: center;
    max-width: 65ch;
    margin: 0 auto;
    padding: var(--paddingtb);
    > * + * {
      margin-top: var(--flow-space, 1rlh);
    }
  }
</style>
